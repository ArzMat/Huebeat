# Secrets huebeat - copia questo file in .env e compila. MAI committare .env.
# HUE_USERNAME e HUE_CLIENTKEY si ottengono col pairing del Bridge
# (pulsante fisico + richiesta con generateclientkey): il programma guidera' il pairing.
HUE_USERNAME=
HUE_CLIENTKEY=

# Spotify (opzionale): metadati brano / palette dalla cover
SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=  # non serve: PKCE
